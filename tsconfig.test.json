{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "sourceMap": false
  },
  "include": [
    "src/api.ts",
    "src/app.ts",
    "src/mock-data.ts",
    "src/persistence.ts",
    "src/player.ts",
    "src/runtime.ts",
    "src/store.ts",
    "src/teacherAvatar.ts",
    "src/types.ts",
    "src/ui.ts",
    "src/utils.ts"
  ]
}
